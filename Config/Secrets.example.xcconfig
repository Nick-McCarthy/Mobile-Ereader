// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// These are public client identifiers, not secrets: no client secret ever ships in the app.
// In CI they come from the repository variables of the same names.

// Dropbox App Console → your app → App key (needed from action-plan task P2.5).
DROPBOX_APP_KEY =

// Microsoft Entra app registration → Application (client) ID (needed from task P2.6).
MICROSOFT_CLIENT_ID =
